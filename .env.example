# DoctorShield Individual Indemnity Portal - Environment Configuration
# Governed by AGENTS.md §4.3 and docs/architecture/SECURITY_DESIGN.md

# API Gateway Endpoints
VITE_API_BASE_URL=https://my-individualindemnity.doctorshield.com/api
VITE_API_TIMEOUT_MS=15000

# Payment Gateway Configuration
VITE_PAYMENT_GATEWAY_URL=https://checkout.gateway.com/pay
VITE_PAYMENT_RETURN_URL=http://localhost:5173/payment/callback

# Security & Session Settings
VITE_SESSION_TIMEOUT_MINUTES=30
VITE_SESSION_INACTIVITY_WARNING_MINUTES=25
VITE_ENABLE_MOCK_API=false

# Telemetry & Monitoring (Production Only)
VITE_SENTRY_DSN=
VITE_APP_ENV=development

