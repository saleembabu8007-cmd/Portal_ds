{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "DoctorShield Design Tokens",
  "version": "3.0.0",
  "description": "Authoritative tokens for DoctorShield Individual Medical Indemnity Insurance governed by Phase 03 Direction B (Structured Premium with Editorial Craft).",
  "color": {
    "brand": {
      "primary": {
        "$value": "#08A5B5",
        "$type": "color",
        "$description": "Official DoctorShield primary teal. Functional accent, action buttons, active borders, progress bars, section indicator bars."
      },
      "secondary": {
        "$value": "#132766",
        "$type": "color",
        "$description": "Official DoctorShield secondary navy. Institutional header, display page titles, grand total headings."
      }
    },
    "interactive": {
      "teal-accessible": {
        "$value": "#066F7B",
        "$type": "color",
        "$description": "Derived deep teal for text and links achieving 5.89:1 contrast on white."
      },
      "teal-high-contrast": {
        "$value": "#055C66",
        "$type": "color",
        "$description": "Derived dark teal for high-contrast links achieving 7.69:1 contrast on white."
      },
      "navy-hover": {
        "$value": "#192C5B",
        "$type": "color",
        "$description": "Deep navy hover state."
      }
    },
    "surface": {
      "canvas": {
        "$value": "#F4F7F9",
        "$type": "color",
        "$description": "Direction B slate page viewport background."
      },
      "card": {
        "$value": "#FFFFFF",
        "$type": "color",
        "$description": "Single-layer crisp white card surface."
      },
      "subtle": {
        "$value": "#F1F5F9",
        "$type": "color",
        "$description": "Neutral wash, inactive track."
      },
      "selected-tint": {
        "$value": "#F0FAFA",
        "$type": "color",
        "$description": "5% teal tint surface for selected tiles and active rows."
      }
    },
    "border": {
      "subtle": {
        "$value": "#DFE6EC",
        "$type": "color",
        "$description": "Subtle 1px border for card outlines and table rows."
      },
      "default": {
        "$value": "#CBD5E1",
        "$type": "color",
        "$description": "Default 1px border for inputs, dropdowns, and unselected tiles."
      },
      "selected": {
        "$value": "#08A5B5",
        "$type": "color",
        "$description": "2px brand teal border for selected tiles and focused controls."
      },
      "section-bar": {
        "$value": "#08A5B5",
        "$type": "color",
        "$description": "3px vertical accent bar on section headings."
      }
    },
    "text": {
      "primary": {
        "$value": "#17253B",
        "$type": "color",
        "$description": "Primary dark body text (13.25:1 contrast on white)."
      },
      "secondary": {
        "$value": "#475569",
        "$type": "color",
        "$description": "Secondary body text and form descriptions (5.64:1 contrast)."
      },
      "muted": {
        "$value": "#64748B",
        "$type": "color",
        "$description": "Muted meta text and helper descriptions (4.62:1 contrast)."
      },
      "label": {
        "$value": "#334155",
        "$type": "color",
        "$description": "Form control labels (7.88:1 contrast)."
      },
      "heading": {
        "$value": "#132766",
        "$type": "color",
        "$description": "Brand navy headings (13.91:1 contrast)."
      }
    }
  },
  "typography": {
    "fontFamily": {
      "heading": {
        "$value": "'Kanit', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
        "$type": "fontFamily"
      },
      "body": {
        "$value": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
        "$type": "fontFamily"
      },
      "mono": {
        "$value": "'JetBrains Mono', 'Fira Code', monospace",
        "$type": "fontFamily"
      }
    },
    "fontWeight": {
      "regular": { "$value": 400, "$type": "fontWeight" },
      "medium": { "$value": 500, "$type": "fontWeight" },
      "ceiling": { "$value": 500, "$type": "fontWeight" }
    }
  },
  "geometry": {
    "inputHeight": { "$value": "46px", "$type": "dimension" },
    "buttonHeight": { "$value": "46px", "$type": "dimension" },
    "cardRadius": { "$value": "10px", "$type": "dimension" },
    "controlRadius": { "$value": "6px", "$type": "dimension" },
    "modalRadius": { "$value": "12px", "$type": "dimension" },
    "touchTargetMin": { "$value": "44px", "$type": "dimension" },
    "appMaxWidth": { "$value": "1200px", "$type": "dimension" },
    "summaryWidth": { "$value": "380px", "$type": "dimension" },
    "headerHeight": { "$value": "56px", "$type": "dimension" }
  }
}
