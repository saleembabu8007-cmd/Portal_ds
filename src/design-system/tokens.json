{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "DoctorShield Design Tokens",
  "version": "1.0.0",
  "color": {
    "brand": {
      "primary": {
        "$value": "#08A5B5",
        "$type": "color",
        "$description": "Official DoctorShield primary teal. For borders, progress bars, focus rings."
      },
      "secondary": {
        "$value": "#132766",
        "$type": "color",
        "$description": "Official DoctorShield secondary navy. For headings and high-contrast labels."
      }
    },
    "interactive": {
      "teal-accessible": {
        "$value": "#066F7B",
        "$type": "color",
        "$description": "Derived deep teal for text and buttons achieving 5.89:1 contrast on white."
      },
      "teal-high-contrast": {
        "$value": "#055C66",
        "$type": "color",
        "$description": "Derived dark teal for body text links achieving 7.69:1 contrast on white."
      }
    },
    "surface": {
      "canvas": {
        "$value": "#F1F4FA",
        "$type": "color",
        "$description": "Page viewport background."
      },
      "card": {
        "$value": "#FFFFFF",
        "$type": "color",
        "$description": "Card surface and modal dialog container."
      }
    },
    "border": {
      "subtle": {
        "$value": "#E2E8F0",
        "$type": "color",
        "$description": "Hairline 1px border for card outlines and table rows."
      },
      "selected": {
        "$value": "#08A5B5",
        "$type": "color",
        "$description": "2px active border for selected option cards."
      }
    }
  },
  "spacing": {
    "base": { "$value": "4px", "$type": "dimension" },
    "1": { "$value": "4px", "$type": "dimension" },
    "2": { "$value": "8px", "$type": "dimension" },
    "3": { "$value": "12px", "$type": "dimension" },
    "4": { "$value": "16px", "$type": "dimension" },
    "6": { "$value": "24px", "$type": "dimension" },
    "8": { "$value": "32px", "$type": "dimension" },
    "12": { "$value": "48px", "$type": "dimension" }
  },
  "typography": {
    "fontFamily": {
      "heading": {
        "$value": "Kanit, -apple-system, sans-serif",
        "$type": "fontFamily"
      },
      "body": {
        "$value": "Inter, -apple-system, sans-serif",
        "$type": "fontFamily"
      }
    },
    "fontWeight": {
      "regular": { "$value": 400, "$type": "fontWeight" },
      "medium": { "$value": 500, "$type": "fontWeight" },
      "semibold": { "$value": 600, "$type": "fontWeight" }
    }
  }
}

