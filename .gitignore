# DoctorShield Individual Indemnity Portal — .gitignore

# Dependencies
node_modules/
audit-runner/node_modules/
.pnp
.pnp.js

# Temporary capture & debug directories
tmp-*/
.audit-runner/
.playwright/
.puppeteer/


# Build outputs
dist/
build/
.next/
out/
.nuxt/
.output/

# Environment files — NEVER commit secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Keep the example file
!.env.example

# OS artifacts
.DS_Store
Thumbs.db
desktop.ini

# Editor
.idea/
.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test coverage
coverage/
.nyc_output/

# Evidence — network captures may contain PII; exclude from public repos
docs/evidence/network/*.har
docs/evidence/recordings/*.mp4
docs/evidence/recordings/*.webm

# TypeScript
*.tsbuildinfo

# Playwright / Cypress test artifacts
test-results/
playwright-report/
cypress/videos/
cypress/screenshots/

# Cache
.cache/
.parcel-cache/
.eslintcache
.stylelintcache

